NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=mysql://ruoyi:ruoyi@127.0.0.1:3306/ruoyi_nest
REDIS_URL=redis://127.0.0.1:6379
JWT_ISSUER=ruoyi-nest-admin
JWT_AUDIENCE=ruoyi-nest-admin-web
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:9527
UPLOAD_DIR=uploads
# Swagger 接口文档
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE=RuoYi Nest Admin API
SWAGGER_DESCRIPTION=RuoYi-inspired administration API
SWAGGER_VERSION=0.1.0
